<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.LoginController">

  <top>
    <HBox styleClass="header-pane">
      <ImageView fitHeight="50.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true">
        <image><Image url="@img/logo.jpg"/></image>
      </ImageView>
      <VBox styleClass="header-inner" HBox.hgrow="ALWAYS">
        <Label text="Banco"                   styleClass="header-title"      maxWidth="Infinity"/>
        <Label text="UBUNTUU"                styleClass="header-title-bold"  maxWidth="Infinity"/>
        <Label text="COMUNIDADE E SABEDORIA"  styleClass="header-subtitle"   maxWidth="Infinity"/>
      </VBox>
    </HBox>
  </top>

  <center>
    <StackPane style="-fx-background-color: #f4f6f5;">
      <VBox styleClass="login-card" StackPane.alignment="CENTER" maxWidth="380">

        <Label text="Área de Acesso" styleClass="login-section-title" maxWidth="Infinity"/>
        <Separator style="-fx-background-color: #e0e8e5; -fx-pref-height: 1;"/>

        <VBox spacing="4">
          <Label text="Utilizador" styleClass="login-label"/>
          <TextField fx:id="txtUsuario" styleClass="login-field"
                     promptText="Nome de utilizador" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="4">
          <Label text="Palavra-passe" styleClass="login-label"/>
          <PasswordField fx:id="txtSenha" styleClass="login-field"
                         promptText="••••••••" maxWidth="Infinity"/>
        </VBox>

        <Button fx:id="btnEntrar" text="ENTRAR" onAction="#handleLogin"
                styleClass="login-btn" maxWidth="Infinity"/>

        <HBox alignment="CENTER" spacing="6" style="-fx-padding: 4 0 0 0;">
          <Label text="Esqueceu a senha?" styleClass="login-link-text"/>
          <Hyperlink fx:id="linkEsqueceu" text="Recuperar"
                     styleClass="login-link-gold" onAction="#esqueceuSenha"/>
        </HBox>

        <HBox alignment="CENTER" spacing="6">
          <Label text="Novo funcionário?" styleClass="login-link-text"/>
          <Hyperlink fx:id="linkCriarConta" text="Criar conta"
                     styleClass="login-link-gold" onAction="#abrirCriarConta"/>
        </HBox>

      </VBox>
    </StackPane>
  </center>

  <bottom>
    <HBox styleClass="footer-bar">
      <Region HBox.hgrow="ALWAYS"/>
      <Label text="Sistema de Senhas — Banco Ubuntuu · Comunidade e Sabedoria"
             style="-fx-font-size: 11; -fx-text-fill: white; -fx-opacity: 0.7;"/>
      <Region HBox.hgrow="ALWAYS"/>
    </HBox>
  </bottom>

</BorderPane>
