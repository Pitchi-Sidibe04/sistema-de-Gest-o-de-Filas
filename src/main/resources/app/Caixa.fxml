<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="app.CaixaController"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

  <!-- CABEÇALHO reutilizável -->
  <top><fx:include source="parts/Header.fxml"/></top>

  <!-- CONTEÚDO PRINCIPAL -->
  <center>
    <VBox styleClass="content-pane">
      <Label text="POR FAVOR, RETIRE APENAS UMA SENHA" styleClass="alert-label"      maxWidth="Infinity"/>
      <Label text="SELECIONE O SERVIÇO DESEJADO"       styleClass="instruction-label" maxWidth="Infinity"/>

      <VBox spacing="8" style="-fx-padding: 12 0 0 0;">

        <!-- A | Depósito -->
        <Button fx:id="deposito" onAction="#deposito"
                styleClass="service-button" maxWidth="Infinity">
          <graphic>
            <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
              <StackPane styleClass="service-key-box">
                <Label text="A" styleClass="service-key-letter"/>
              </StackPane>
              <Label text="Depósito" styleClass="service-label"
                     HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
          </graphic>
        </Button>

        <!-- A | Levantamento -->
        <Button fx:id="levantamento" onAction="#levantamento"
                styleClass="service-button" maxWidth="Infinity">
          <graphic>
            <HBox spacing="12" style="-fx-alignment: CENTER_LEFT;">
              <StackPane styleClass="service-key-box">
                <Label text="A" styleClass="service-key-letter"/>
              </StackPane>
              <Label text="Levantamento" styleClass="service-label"
                     HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
          </graphic>
        </Button>

      </VBox>

      <!-- Empurra o VOLTAR para baixo do centro -->
      <Region VBox.vgrow="ALWAYS"/>

      <!-- VOLTAR — dentro do center, acima do rodapé -->
      <HBox styleClass="footer-action-bar">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="VOLTAR" onAction="#voltarMenu" styleClass="back-button"/>
      </HBox>
    </VBox>
  </center>

  <!-- RODAPÉ simples — só o logo e nome, sem botão -->
  <bottom>
    <HBox styleClass="footer-pane">
      <ImageView fitHeight="50.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true">
        <image><Image url="@img/logo.jpg"/></image>
      </ImageView>
      <VBox styleClass="header-inner" HBox.hgrow="ALWAYS">
        <Label text="Banco"                  styleClass="header-title"      maxWidth="Infinity"/>
        <Label text="UBUNTUU"                styleClass="header-title-bold"  maxWidth="Infinity"/>
        <Label text="COMUNIDADE E SABEDORIA" styleClass="header-subtitle"    maxWidth="Infinity"/>
      </VBox>
    </HBox>
  </bottom>

</BorderPane>
